{
  "name": "voiceroom",
  "version": "0.1.2",
  "description": "Aplicativo desktop minimalista de voz e compartilhamento de tela.",
  "private": true,
  "main": "client/src/main/main.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "prestart": "npm run bundle:renderer",
    "start": "electron .",
    "server": "node server/src/server.js",
    "dev": "npm run start",
    "test": "node --test tests/*.test.js",
    "check": "node --check server/src/server.js && node --check client/src/main/main.js && node --check client/src/preload/preload.js && node --check client/src/renderer/app.js && node --check client/src/renderer/webrtc.js && node --check client/src/renderer/screen-quality.js && node --check client/src/renderer/rnnoise-worklet.js",
    "bundle:renderer": "node scripts/bundle-renderer.js",
    "bundle:renderer:production": "node scripts/bundle-renderer.js --production",
    "prebuild": "npm run bundle:renderer:production",
    "build": "electron-builder --dir",
    "predist": "npm run bundle:renderer:production",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.voiceroom.desktop",
    "productName": "VoiceRoom",
    "icon": "client/assets/voice-icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "client/**/*",
      "shared/**/*",
      "package.json",
      "node_modules/socket.io-client/**/*",
      "node_modules/socket.io/**/*",
      "node_modules/socket.io-adapter/**/*",
      "node_modules/socket.io-parser/**/*",
      "node_modules/@socket.io/component-emitter/**/*",
      "node_modules/engine.io/**/*",
      "node_modules/engine.io-parser/**/*",
      "node_modules/accepts/**/*",
      "node_modules/base64id/**/*",
      "node_modules/cors/**/*",
      "node_modules/cookie/**/*",
      "node_modules/debug/**/*",
      "node_modules/mime-db/**/*",
      "node_modules/mime-types/**/*",
      "node_modules/negotiator/**/*",
      "node_modules/object-assign/**/*",
      "node_modules/vary/**/*",
      "node_modules/ms/**/*",
      "node_modules/ws/**/*"
    ],
    "win": {
      "icon": "client/assets/voice-icon.ico",
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "marcio1335",
      "repo": "voiceroom",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "client/assets/voice-icon.ico",
      "uninstallerIcon": "client/assets/voice-icon.ico",
      "installerHeaderIcon": "client/assets/voice-icon.ico",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "electron-updater": "^6.8.9",
    "socket.io": "^4.8.1"
  }
}
